{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyAnyRequestNotOverHTTPS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::afterward-documents-992617582533-london",
        "arn:aws:s3:::afterward-documents-992617582533-london/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyOldTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::afterward-documents-992617582533-london",
        "arn:aws:s3:::afterward-documents-992617582533-london/*"
      ],
      "Condition": {
        "NumericLessThan": {
          "s3:TlsVersion": "1.2"
        }
      }
    }
  ]
}
