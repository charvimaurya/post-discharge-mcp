AWS_REGION=eu-west-2
DOCUMENT_BUCKET=afterward-documents-<ACCOUNT_ID>-london
RECOVERY_STATE_TABLE=PostDischargeRecoveryState
TEST_PATIENT_ID=demo_patient_001
AGENT_API_URL=http://127.0.0.1:8002
# Server only. Must match the bridge key. Never prefix with NEXT_PUBLIC_.
BRIDGE_KEY=
# Optional: letters one browser session may upload (default 3). Restart the server after changing it.
# DEMO_UPLOADS_PER_SESSION=3

# Amplify: use these instead of a direct BRIDGE_KEY; see deployment/amplify/README.md.
# AFTERWARD_RUNTIME=amplify
# AFTERWARD_AWS_REGION=eu-west-2
# AGENT_API_URL=https://bridge.example.com
# APP_ORIGIN=https://your-branch.example.com
# BRIDGE_KEY_SECRET_ARN=arn:aws:secretsmanager:eu-west-2:<ACCOUNT_ID>:secret:<BRIDGE_KEY_SECRET>
# Cloud abuse limits: shared DynamoDB table; trusted XFF hop count must match the actual proxy chain.
# DEMO_LIMIT_TABLE=<provisioned-counter-table>
# DEMO_TRUSTED_PROXY_HOPS=1
