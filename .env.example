# Copy to .env and fill in: cp .env.example .env
# Never commit .env.

AWS_REGION=eu-west-2

# Models
MODEL_MODE=test
TEST_MODEL_ID=
FINAL_EXTRACTION_MODEL_ID=
FINAL_AGENT_MODEL_ID=
IMAGE_MODEL_ID=

# DynamoDB
RECOVERY_STATE_TABLE=PostDischargeRecoveryState
EVENT_HISTORY_TABLE=PostDischargeEventHistory

# Document ingestion
DOCUMENT_BUCKET=
PROCESSING_QUEUE_URL=

# RAG / S3 Vectors
S3_VECTOR_BUCKET=
S3_VECTOR_INDEX=afterward-discharge-index
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=512

# MCP server auth (local dev uses a plain token; deployment uses the secret ARN)
MCP_AUTH_TOKEN=afterward-local-dev-token
MCP_AUTH_TOKEN_SECRET_ARN=
MCP_URL=http://127.0.0.1:8000/mcp
# Set the same private key in web/.env.local; use a distinct random cloud key.
BRIDGE_KEY=
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the Python bridge reaches the MCP server
MCP_URL=http://127.0.0.1:8001/mcp

# Shared key the web server sends to the bridge as X-AfterWard-Key.
# Must match BRIDGE_KEY in web/.env.local. POST /reset refuses without it.
BRIDGE_KEY=
# Demo only: show Alexa turns on /demo (GET /conversation). Memory only, last 20 turns, never logged.
ALEXA_FEED_ENABLED=true
# Demo only: after this many real hours with no chat and no reset, the next visit starts fresh. 0 = off.
DEMO_IDLE_RESET_HOURS=2

# Use real patient-local time by default. Set CLOCK_MODE=demo for recording.
CLOCK_MODE=real
DEMO_FIXED_NOW=2026-10-23T07:00:00+01:00

# Alexa skill endpoint
# Skill ID from the Alexa developer console (amzn1.ask.skill....); requests from any other skill are refused.
ALEXA_SKILL_ID=
# Check Amazon's request signature and certificate. Keep true; false only for local tests.
ALEXA_VERIFY_SIGNATURE=true
# Refuse requests whose timestamp is more than 150 seconds old (replay protection). Keep true.
ALEXA_VERIFY_TIMESTAMP=true
# Seconds to wait for the agent before saying "Give me a moment, then ask me again." (Alexa waits about 8.)
ALEXA_AGENT_TIMEOUT_SECONDS=7
